# Stripe — for payment_links.py only. Copy to `.env` beside this file.
# `.env` is git-ignored. Never commit a key, and never a live one: the tool
# refuses anything but a Stripe *test* key.

# Dashboard → Developers → API keys, with "Test mode" on. Starts sk_test_.
STRIPE_SECRET_KEY=
# What the Payment Links charge in. 1 token = Rs. 1.
STRIPE_CURRENCY=pkr
