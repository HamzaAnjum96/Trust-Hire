# Trust Hire dev server — copy to `.env` beside this file and fill in.
# `.env` is git-ignored. Never commit a real key, and never a live one: the
# server refuses anything but a Stripe *test* key.

# --- Stripe (test mode) ------------------------------------------------------
# Dashboard → Developers → API keys, with "Test mode" on. Starts sk_test_.
STRIPE_SECRET_KEY=
# Only needed for webhooks: printed by `stripe listen --forward-to
# localhost:8787/payments/webhook`. Starts whsec_.
STRIPE_WEBHOOK_SECRET=
# What Checkout charges in. 1 token = Rs. 1.
STRIPE_CURRENCY=pkr

# --- The fare agent's model -------------------------------------------------
# Any OpenAI-compatible chat endpoint that supports tool calls.
#   Ollama:     http://localhost:11434/v1   (ollama pull qwen2.5:3b)
#   LM Studio:  http://localhost:1234/v1
#   llama.cpp:  http://localhost:8080/v1    (llama-server --jinja --alias <LLM_MODEL>)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# Local servers need none. Set it only for a hosted OpenAI-compatible API.
LLM_API_KEY=

# --- The server itself ------------------------------------------------------
DEV_SERVER_PORT=8787
# Browser origins allowed to call it. `:*` means any port. Add the GitHub
# Pages origin to use the deployed app against this machine, e.g.
#   http://localhost:*,http://127.0.0.1:*,https://<you>.github.io
DEV_SERVER_ORIGINS=http://localhost:*,http://127.0.0.1:*
